// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CONTENT_CREATOR
  USER
  MODERATOR
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  email             String             @unique
  password          String
  bio               String?
  avatar            String?
  isVerified        Boolean            @default(false)
  role              UserRole           @default(USER)
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  followers         Follow[]           @relation("followers")
  following         Follow[]           @relation("following")
  notifications     Notification[]     @relation("NotificationUser")
  sentNotifications Notification[]     @relation("NotificationSender")
  messages          Message[]
  bookmarks         Bookmark[]
  duets             Duet[]
  analytics         UserAnalytic[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  Account           Account[]
  Session           Session[]
  LikeComment       LikeComment[]
  Reply             Reply[]
  View              View[]
  Reaction          Reaction[]
  UserConversation  UserConversation[]
  Conversation      Conversation[]     @relation("ConversationParticipants")
  Interest          Topic[]
  IpLog             IpLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model IpLog {
  id          String   @id @default(uuid())
  ip          String // "92.184.105.12"
  countryCode String // "FR"
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Post {
  id             String         @id @default(uuid())
  caption        String?
  videoUrl       String // Stockage (S3, Cloudinary, etc.)
  thumbnail      String? // Miniature custom
  duration       Int? // Durée en secondes
  author         User           @relation(fields: [authorId], references: [id])
  authorId       String
  likes          Like[]
  comments       Comment[]
  hashtags       Hashtag[]
  views          View[] // Statistiques de vues
  bookmarks      Bookmark[]
  duetsOriginal  Duet[]         @relation("OriginalPost")
  duetsDuet      Duet[]         @relation("DuetPost")
  isPublic       Boolean        @default(true)
  allowComments  Boolean        @default(true)
  allowDuets     Boolean        @default(true)
  allowDownloads Boolean        @default(false)
  location       String?
  scheduledAt    DateTime? // Pour les posts planifiés (Pro)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Notification   Notification[]
  detectedTopics Topic[]

  Sound Sound[] @relation(name: "post")
}

model Topic {
  id    String @id @default(uuid())
  name  String @unique // "Tech", "Food", etc.
  posts Post[]
  User  User[]
}

model Like {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  createdAt DateTime @default(now())
}

model Comment {
  id        String        @id @default(uuid())
  text      String
  author    User          @relation(fields: [authorId], references: [id])
  authorId  String
  post      Post          @relation(fields: [postId], references: [id])
  postId    String
  replies   Reply[] // Réponses aux commentaires
  likes     LikeComment[]
  createdAt DateTime      @default(now())
}

// Likes sur les commentaires
model LikeComment {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id])
  commentId String
  createdAt DateTime @default(now())

  @@unique([userId, commentId]) // Un like unique par utilisateur/commentaire
}

// Réponses aux commentaires
model Reply {
  id        String   @id @default(uuid())
  text      String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  comment   Comment  @relation(fields: [commentId], references: [id])
  commentId String
  createdAt DateTime @default(now())
}

//Favoris/Sauvegardes
model Bookmark {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  createdAt DateTime @default(now())
}

model Follow {
  id          String   @id @default(uuid())
  follower    User     @relation(name: "followers", fields: [followerId], references: [id])
  followerId  String
  following   User     @relation(name: "following", fields: [followingId], references: [id])
  followingId String
  createdAt   DateTime @default(now())
}

// Musiques/Sons
model Sound {
  id        String   @id @default(uuid())
  name      String
  artist    String?
  audioUrl  String
  duration  Int
  post      Post     @relation(name: "post", fields: [postId], references: [id])
  postId    String
  createdAt DateTime @default(now())
}

// Mots-clés tendances
model Hashtag {
  id        String   @id @default(uuid())
  name      String   @unique
  posts     Post[]
  trendRank Int? // Classement des hashtags tendances
  createdAt DateTime @default(now())
}

model Duet {
  id             String   @id @default(uuid())
  originalPost   Post     @relation("OriginalPost", fields: [originalPostId], references: [id])
  originalPostId String
  duetPost       Post     @relation("DuetPost", fields: [duetPostId], references: [id])
  duetPostId     String
  createdAt      DateTime @default(now())
  User           User?    @relation(fields: [userId], references: [id])
  userId         String?
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation("NotificationUser", fields: [userId], references: [id])
  userId    String
  type      String // "like", "comment", "follow", etc.
  post      Post?    @relation(fields: [postId], references: [id])
  postId    String?
  sender    User?    @relation("NotificationSender", fields: [senderId], references: [id])
  senderId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Vues
model View {
  id        String   @id @default(uuid())
  post      Post     @relation(fields: [postId], references: [id])
  postId    String
  viewer    User?    @relation(fields: [viewerId], references: [id])
  viewerId  String?
  device    String? // Mobile, Web, etc.
  country   String?
  duration  Int? // Durée de visionnage (en secondes)
  createdAt DateTime @default(now())
}

// Stats créateur
model UserAnalytic {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  totalViews     Int      @default(0)
  totalLikes     Int      @default(0)
  totalFollowers Int      @default(0)
  engagementRate Float?
  updatedAt      DateTime @updatedAt
}

// Conversations entre utilisateurs
model Conversation {
  id               String             @id @default(uuid())
  participants     User[]             @relation("ConversationParticipants") // Plusieurs users peuvent être dans un groupe
  messages         Message[] // Tous les messages de la conversation
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt // Dernière activité
  UserConversation UserConversation[]
}

// Messages échangés
model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  content        String? // Texte (peut être null si c'est un média)
  mediaUrl       String? // Photo/Video/GIF (lien vers le fichier)
  isRead         Boolean      @default(false)
  isDeleted      Boolean      @default(false) // Pour la suppression côté utilisateur
  reactions      Reaction[] // Réactions (❤️, 😂, etc.)
  repliedTo      Message?     @relation("MessageReplies", fields: [repliedToId], references: [id])
  repliedToId    String? // Réponse à un autre message
  createdAt      DateTime     @default(now())

  Message Message[] @relation("MessageReplies")
}

// Réactions aux messages
model Reaction {
  id        String   @id @default(uuid())
  emoji     String // "❤️", "😂", "🔥", etc.
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  message   Message  @relation(fields: [messageId], references: [id])
  messageId String
  createdAt DateTime @default(now())
}

// Liaison entre Users et Conversations) (pour les groupes
model UserConversation {
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  isMuted        Boolean      @default(false) // Désactiver les notifications
  lastSeenAt     DateTime? // Dernière lecture

  @@id([userId, conversationId]) // Clé composite
}
